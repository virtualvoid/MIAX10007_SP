<UserControl x:Class="DigitApp.Views.RecognitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DigitApp.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- jedna feature mapa = malý obrázok zväčšený bez vyhladzovania, nech vidno pixely -->
        <DataTemplate x:Key="MapTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,4,4">
                <Image Source="{Binding}" Width="44" Height="44"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ľavý stĺpec: kreslenie, náhľad vstupu a hra -->
            <StackPanel Grid.Column="0" Width="282">
                <TextBlock Text="Nakresli číslicu" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border BorderBrush="Gray" BorderThickness="1" Width="282" Height="282">
                    <controls:DrawingPad x:Name="Pad" StrokesChanged="Pad_StrokesChanged"/>
                </Border>
                <Button Content="Vymazať (Delete)" Margin="0,10,0,0" Padding="8,4" Command="{Binding ClearCommand}"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border BorderBrush="Gray" BorderThickness="1" Width="86" Height="86" Background="Black">
                        <Image Source="{Binding Preview}" Width="84" Height="84"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="Takto vidí vstup sieť (28×28 pixelov po predspracovaní)" TextWrapping="Wrap"
                               Foreground="Gray" Width="170" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DataContext="{Binding Game}" Margin="0,14,0,0">
                    <Button Content="{Binding StartButtonText}" Padding="8,4" Command="{Binding StartCommand}"/>
                    <Border Visibility="{Binding IsPanelVisible, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="SteelBlue" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Info}" Foreground="Gray"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nakresli:" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Target}" FontSize="40" FontWeight="Bold" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MinHeight="34" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Potvrdiť (Enter)" Padding="8,3" Command="{Binding SubmitCommand}"/>
                                <Button Content="Skončiť" Padding="8,3" Margin="8,0,0,0" Command="{Binding EndCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- pravý stĺpec: porovnanie modelov, fuzzy hodnotenie a pohľad do vnútra CNN -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Porovnanie modelov na tej istej kresbe" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Notice}" Foreground="Firebrick" TextWrapping="Wrap"/>

                <ItemsControl ItemsSource="{Binding Panels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Info}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Digit}" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Confidence}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Bars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Digit}" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="1"
                                                                 Value="{Binding Probability, Mode=OneWay}" Foreground="{Binding Brush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- fuzzy hodnotenie spoľahlivosti rozpoznania -->
                    <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="10,8"
                            DataContext="{Binding Reliability}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Fuzzy hodnotenie spoľahlivosti" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Label}" FontSize="20" FontWeight="Bold" Foreground="{Binding Brush}"/>
                            <TextBlock Text="{Binding ScoreText}" Foreground="Gray"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Score, Mode=OneWay}" Height="10"
                                         Foreground="{Binding Brush}" Margin="0,4,0,6"/>
                            <ItemsControl ItemsSource="{Binding Inputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Sets}" Foreground="Gray" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas Width="300" Height="50" Margin="0,8,0,0" Background="#10000000" HorizontalAlignment="Left">
                                <Polygon Points="{Binding Curve}" Fill="#554682B4" Stroke="SteelBlue" StrokeThickness="1"/>
                                <Line X1="{Binding CentroidX}" X2="{Binding CentroidX}" Y1="0" Y2="50"
                                      Stroke="Black" StrokeThickness="2" StrokeDashArray="3 2"/>
                            </Canvas>
                            <DockPanel Width="300" HorizontalAlignment="Left">
                                <TextBlock DockPanel.Dock="Right" Text="100" FontSize="10" Foreground="Gray"/>
                                <TextBlock Text="0" FontSize="10" Foreground="Gray"/>
                            </DockPanel>
                            <TextBlock Text="Agregovaná výstupná množina a jej ťažisko (čiarkovaná čiara)"
                                       FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- feature mapy konvolučných vrstiev -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Čo vidí CNN" FontWeight="SemiBold"/>
                        <TextBlock Text="1. konvolučná vrstva (8 filtrov, po ReLU)" Margin="0,4,0,4"/>
                        <ItemsControl ItemsSource="{Binding FirstConvMaps}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}"
                                      ItemTemplate="{StaticResource MapTemplate}"/>
                        <TextBlock Text="2. konvolučná vrstva (16 filtrov, po ReLU)" Margin="0,6,0,4"/>
                        <ItemsControl ItemsSource="{Binding SecondConvMaps}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}"
                                      ItemTemplate="{StaticResource MapTemplate}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
