<Window x:Class="DigitApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DigitApp.Views"
        xmlns:viewModels="clr-namespace:DigitApp.ViewModels"
        xml:lang="sk-SK"
        Title="Rozpoznávanie číslic – vlastná neurónová sieť"
        Width="1130" Height="860"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Delete zmaže plátno, Enter potvrdí kolo v hre (prikaz je dostupný len počas hry) -->
        <KeyBinding Key="Delete" Command="{Binding Recognition.ClearCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding Recognition.Game.SubmitCommand}"/>
    </Window.InputBindings>

    <TabControl Margin="8">
        <TabItem Header="Rozpoznávanie">
            <views:RecognitionView DataContext="{Binding Recognition}"/>
        </TabItem>
        <TabItem Header="Trénovanie">
            <views:TrainingView DataContext="{Binding Training}"/>
        </TabItem>
        <TabItem Header="Vyhodnotenie">
            <views:EvaluationView DataContext="{Binding Evaluation}"/>
        </TabItem>
    </TabControl>
</Window>
